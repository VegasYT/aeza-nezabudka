{
	"name": "invoice-keeper-frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"packageManager": "pnpm@10.28.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"typecheck": "tsc -b",
		"lint": "eslint .",
		"lint:styles": "stylelint \"src/**/*.css\" --allow-empty-input",
		"lint:fsd": "steiger ./src",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "pnpm typecheck && pnpm lint && pnpm lint:styles && pnpm lint:fsd && pnpm format:check && pnpm test && vite build",
		"api:generate": "openapi-ts"
	},
	"dependencies": {
		"@fontsource-variable/exo-2": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@mantine/core": "^9.7.3",
		"@mantine/dates": "^9.7.3",
		"@mantine/hooks": "^9.7.3",
		"@mantine/modals": "^9.7.3",
		"@mantine/notifications": "^9.7.3",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-query": "^5.104.5",
		"@tanstack/react-router": "^1.170.46",
		"axios": "^1.20.0",
		"dayjs": "^1.11.23",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"uqr": "^0.1.3",
		"zod": "^4.6.7",
		"zustand": "^5.0.16"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@eslint/js": "^10.0.1",
		"@feature-sliced/steiger-plugin": "^0.8.0",
		"@hey-api/openapi-ts": "0.99.0",
		"@rolldown/plugin-babel": "^0.2.4",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@tanstack/eslint-plugin-query": "^5.104.5",
		"@tanstack/eslint-plugin-router": "^1.162.0",
		"@tanstack/react-query-devtools": "^5.104.5",
		"@tanstack/react-router-devtools": "^1.167.2",
		"@tanstack/router-plugin": "^1.168.48",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/babel__core": "^7.20.5",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"globals": "^17.13.0",
		"jsdom": "^30.1.3",
		"msw": "2.15.0",
		"postcss": "^8.5.31",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"prettier": "^3.9.10",
		"steiger": "^0.8.0",
		"stylelint": "^17.16.0",
		"stylelint-config-css-modules": "^4.6.0",
		"stylelint-config-standard": "^40.0.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
