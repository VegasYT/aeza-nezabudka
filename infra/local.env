# Настройки для запуска всей системы на своей машине, без домена и сертификатов.
# Секретов здесь нет: пароли только для локальной проверки. Запуск из корня репозитория:
#   docker compose -f infra/compose.prod.yaml --env-file infra/local.env up -d --build
# Подробности - README.md в корне.

# Адреса: панель на http://localhost:8090, Grafana на http://grafana.localhost:8090 и т. д.
DOMAIN=localhost:8090
SCHEME=http
HTTP_PORT=8090
HTTPS_PORT=8453

POSTGRES_PASSWORD=local

# Вход без Aéza: email на @dev.local, пароль DEV_LOGIN_PASSWORD; для +2fa код 000000.
APP_ENV=development
DEV_LOGIN_PASSWORD=dev
ADMIN_EMAILS=admin@dev.local,admin+2fa@dev.local
# участник с ролью user, его добавляет команда seed
DEMO_USER_EMAIL=user@dev.local
AEZA_API_URL=https://my.aeza.ru/api

TZ=Europe/Moscow

# Telegram необязателен: без токена напоминания копятся в очереди. Свой бот - токен от @BotFather,
# общий чат - id группы с ботом, например -1001234567890.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PROXY_URL=
PUBLIC_URL=

# Kafka для демо встраивания и Kafka UI на http://kafka.localhost:8090
COMPOSE_PROFILES=integration
KAFKA_BROKERS=kafka:19092
KAFKA_UI_PASSWORD=nezabudka

GRAFANA_ADMIN_PASSWORD=nezabudka
PGADMIN_EMAIL=admin@nezabudka.space
PGADMIN_PASSWORD=nezabudka
