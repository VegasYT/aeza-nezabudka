# Настройки сервера для infra/compose.prod.yaml. Скопируй в infra/.env и заполни;
# infra/.env в репозиторий не попадает. Сгенерировать пароль: openssl rand -hex 24

# Домен сайта: панель на https://<домен>, API на https://<домен>/api/v1, Swagger на /api/v1/docs.
DOMAIN=nezabudka.space
# https на сервере; http только для локальной проверки набора без сертификатов.
SCHEME=https

# Пароль PostgreSQL. Обязательно.
POSTGRES_PASSWORD=change-me

# Администраторы - email аккаунтов Aéza через запятую (ADR-014). Обязательно.
ADMIN_EMAILS=glavbuh@example.com
# API Aéza и срок сессии, часов.
AEZA_API_URL=https://my.aeza.ru/api
SESSION_TTL_HOURS=12
# Тестовые аккаунты без Aéza: пароль для email на @dev.local из белого списка, для email с +2fa
# код 000000. Остальные входят через Aéza как обычно. Нужен APP_ENV=development.
APP_ENV=production
DEV_LOGIN_PASSWORD=

# Часовой пояс системы: по нему считается "сегодня".
TZ=Europe/Moscow
LOG_LEVEL=info

# Telegram (ADR-010): без токена напоминания только копятся в очереди.
TELEGRAM_BOT_TOKEN=
# Общий чат бухгалтерии, например -1001234567890. Пусто - общий чат выключен.
TELEGRAM_CHAT_ID=
# Прокси к api.telegram.org, socks5:// или http://, если Telegram с сервера недоступен.
TELEGRAM_PROXY_URL=
# Тема супергруппы общего чата (message_thread_id); пусто - писать без темы.
TELEGRAM_THREAD_ID=
# Окно напоминаний, дней. Окно из панели важнее, пока его не сбросят; у платежа может быть своё.
REMINDER_DAYS_BEFORE=3

# Встраивание (ADR-011), необязательно. Kafka для демо: COMPOSE_PROFILES=integration и KAFKA_BROKERS=kafka:19092,
# тогда на https://kafka.<домен> откроется Kafka UI (пользователь admin, пароль KAFKA_UI_PASSWORD).
WEBHOOK_URL=
WEBHOOK_SECRET=
KAFKA_BROKERS=
KAFKA_TOPIC=invoice-keeper.events
COMPOSE_PROFILES=
# Пароль Kafka UI. Обязательно, даже без профиля integration: compose проверяет все сервисы.
KAFKA_UI_PASSWORD=change-me

# Чеки оплаты (ADR-017) в Garage из этого набора; Garage сам создаёт ключ и бакет при первом
# запуске. Обязательно. Ключ: echo GK$(openssl rand -hex 12), секреты: openssl rand -hex 32.
# Своё S3-хранилище заказчика - S3_ENDPOINT_URL, S3_BUCKET и S3_REGION, Garage тогда не нужен.
S3_ACCESS_KEY_ID=GK000000000000000000000000
S3_SECRET_ACCESS_KEY=change-me
GARAGE_RPC_SECRET=change-me
# Токен admin API Garage для панели (openssl rand -hex 32). Обязательно.
GARAGE_ADMIN_TOKEN=change-me
# Вход в панель хранилища на https://storage.<домен>: логин:bcrypt-хеш пароля, в одинарных
# кавычках из-за знаков $. Хеш: docker run --rm caddy:2.10-alpine caddy hash-password -p 'пароль'
GARAGE_WEBUI_AUTH='admin:change-me'

# Участник демо с ролью user для команды seed - email аккаунта Aéza, необязательно.
DEMO_USER_EMAIL=

# Grafana на https://grafana.<домен>: пользователь admin и этот пароль. Обязательно.
GRAFANA_ADMIN_PASSWORD=change-me
# Сколько хранить метрики.
PROMETHEUS_RETENTION=7d

# pgAdmin на https://pgadmin.<домен>: вход по этим email и паролю. Обязательно.
# Email - любой с настоящим доменом: адреса на .local pgAdmin не принимает.
PGADMIN_EMAIL=admin@nezabudka.space
PGADMIN_PASSWORD=change-me
