# Пример настроек backend. Скопируй в .env и подставь свои значения; .env не коммитится.

# Адрес PostgreSQL, только драйвер asyncpg. Обязательно.
DATABASE_URL=postgresql+asyncpg://app:change-me@localhost:5432/app

# Единый часовой пояс системы, имя IANA: по нему считается "сегодня". Обязательно.
TZ=Europe/Moscow

# development, test или production.
APP_ENV=development

# Подменить "сегодня" для демо, формат ГГГГ-ММ-ДД. При APP_ENV=production запрещено.
# CLOCK_TODAY=2026-11-30

# debug, info, warning или error.
LOG_LEVEL=info

# Размер пула соединений с базой у каждого процесса.
DATABASE_POOL_SIZE=10

# Сколько секунд worker ждёт текущую работу при остановке.
SHUTDOWN_TIMEOUT=15

# Где слушает api.
HTTP_HOST=0.0.0.0
HTTP_PORT=8000

# Порт /healthz и /metrics процесса worker; только внутри сети compose.
WORKER_HTTP_PORT=9100

# --- Telegram и напоминания: процессы api и worker (ADR-004, ADR-010) ---

# Токен бота от @BotFather. Без него worker не отправляет напоминания, только ставит их в очередь.
# TELEGRAM_BOT_TOKEN=123456:change-me

# Общий чат бухгалтерии, бот добавлен в него заранее. Пусто - общий чат выключен. Нужен токен.
# TELEGRAM_CHAT_ID=-1001234567890

# Прокси для запросов к Telegram, socks5:// или http://. Необязательно.
# TELEGRAM_PROXY_URL=socks5://user:password@proxy:1080

# Тема супергруппы общего чата (message_thread_id). Пусто - без темы.
# TELEGRAM_THREAD_ID=7

# Адрес веб-панели для кнопки "Открыть в панели" под сообщениями. Пусто - кнопки нет.
# PUBLIC_URL=https://nezabudka.space

# За сколько дней до срока напоминать, от 0 до 30. Окно, заданное в панели (PATCH /settings),
# важнее этого значения, пока его не сбросят; у платежа может быть своё окно.
REMINDER_DAYS_BEFORE=3

# --- Интеграционные события для систем заказчика: процессы api и worker (ADR-011) ---
# Адаптер включается, если задан его адрес. Без адаптеров события только хранятся.

# Webhook: POST JSON события, подпись HMAC-SHA256 тела в заголовке X-Signature. Секрет обязателен.
# WEBHOOK_URL=https://erp.example.local/hooks/invoice-keeper
# WEBHOOK_SECRET=change-me

# Kafka заказчика: брокеры через запятую и топик; ключ сообщения - идентификатор платежа.
# KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=invoice-keeper.events

# --- Только процесс api: вход через аккаунты Aéza (ADR-014) ---

# API Aéza: проверка пароля и 2FA при входе, проверка ключей X-API-KEY.
AEZA_API_URL=https://my.aeza.ru/api

# Администраторы - email аккаунтов Aéza через запятую. Пароль хранит Aéza.
# Список синхронизируется при каждом запуске api; через панель и API администраторы не меняются.
ADMIN_EMAILS=glavbuh@example.com

# Срок сессии после входа, часов; продления нет.
SESSION_TTL_HOURS=12

# Тестовые аккаунты без Aéza: email на @dev.local из белого списка с этим паролем, для email
# с +2fa код 000000, ключ X-API-KEY вида dev:<email>:<пароль>. Остальные входят через Aéza.
# При APP_ENV=production запрещено.
# DEV_LOGIN_PASSWORD=dev

# --- Только команда тестовых данных: uv run python -m app.seed ---

# Участник с ролью user для демо - email аккаунта Aéza. Пусто - участник не добавляется.
# DEMO_USER_EMAIL=buh@example.com

# --- Чеки оплаты: процессы api и worker (ADR-017) ---
# S3-совместимое хранилище; без адреса чеки выключены. Локально: Garage из infra/compose.dev.yaml.
# S3_ENDPOINT_URL=http://localhost:3900
# S3_BUCKET=receipts
# S3_ACCESS_KEY_ID=GK0123456789abcdef01234567
# S3_SECRET_ACCESS_KEY=change-me
# S3_REGION=garage

